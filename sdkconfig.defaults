

# Compiler Optimization for Size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Protocomm security
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# Disable Unused Network and Wi-Fi Features (If applicable)
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_LWIP_IPV6=n



# Run at max core frequency to keep plenty of headroom for the 10 ms
# sample ticOptimizek + occasional 4 KB flash erase/write.
CONFIG_ESP32C6_DEFAULT_CPU_FREQ_160=y

# Give the esp_timer callback task (which we use as the sample tick,
# see main.c) enough stack; it also directly touches the log buffer.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584

# Not required, but recommended if you also use the console/log UART
# heavily at the same time as logging -- keeps UART flushes from ever
# stalling the timer task.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# Use our custom partition table instead of one of the stock ones
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Wi-Fi FTM (Kconfig symbol names confirmed from esp_wifi.h, IDF v6.0)
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
CONFIG_ESP_WIFI_FTM_RESPONDER_SUPPORT=y


# --- BLE (NimBLE) for start/stop control from a phone ---------------
# ESP32-C6 only supports the NimBLE host (no Bluedroid classic BT
# stack), which is IDF's default/recommended host for this chip anyway.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=0
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

